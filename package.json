{
  "name": "farzaad-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run check:content && vite build",
    "preview": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:content": "node scripts/check-content.mjs",
    "check:content:strict": "node scripts/check-content.mjs --strict",
    "check": "npm run check:content && npm run typecheck && npm run lint",
    "test": "node --test scripts/check-content.test.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "lucide-react": "0.575.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
